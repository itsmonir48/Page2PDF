# Page2PDF Environment Configuration
# Copy this file to .env and customize as needed

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_TITLE=Page2PDF

# Security
MAX_PAGE_SIZE_MB=20
REQUEST_TIMEOUT=30
MAX_REDIRECTS=5
MAX_IMAGE_SIZE_MB=5
MAX_IMAGES_PER_PAGE=50

# PDF
PDF_RETENTION_HOURS=1
OUTPUT_DIR=output

# Database
DATABASE_URL=sqlite:///page2pdf.db

# Playwright (set to true to enable JS rendering fallback)
ENABLE_PLAYWRIGHT=true
